#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
#include <string.h>
static int allocation_count, fail_at, live_count;
static void *gdMalloc(size_t size) {
    if (++allocation_count == fail_at) return NULL;
    void *p = calloc(1, size);
    if (!p) exit(90);
    live_count++;
    return p;
}
static void gdFree(void *p) {
    /* Stop at the failed-row cleanup before the old unsigned loop proceeds. */
    if (!p) { puts("FAIL: cleanup visited an unallocated weight row"); exit(20); }
    live_count--;
    free(p);
}
static int overflow2(int a, int b) {
    return a <= 0 || b <= 0 || a > INT_MAX / b;
}
@TYPES@
@FUNCTIONS@
int main(int argc, char **argv) {
    if (argc != 2) return 91;
    unsigned int window = 3;
    if (!strcmp(argv[1], "first")) fail_at = 3;
    else if (!strcmp(argv[1], "later")) fail_at = 4;
    else if (!strcmp(argv[1], "overflow")) window = INT_MAX / sizeof(double) + 1;
    else if (strcmp(argv[1], "normal")) return 92;
    LineContribType *value = _gdContributionsAlloc(3, window);
    if (!strcmp(argv[1], "normal")) {
        if (!value) return 93;
        _gdContributionsFree(value);
    } else if (value) return 94;
    if (live_count != 0) return 95;
    printf("PASS %s\n", argv[1]);
    return 0;
}
