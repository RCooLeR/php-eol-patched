+--CREDITS--
+brettgervasoni
+--SKIPIF--
+<?php if (!extension_loaded("soap")) die("skip soap extension not available"); ?>
+--FILE--
+<?php
+
+class Handler {
+    public function test(...$args) {
+        $GLOBALS['result'] = $args;
+    }
