  "adaptations": [
    "PHP 5.6 mysqlnd native packet, value and connection ownership APIs.",
    "SOAP decoding value ownership is separate from serialization XML-node references.",
    "SOAP client single-value returns use refcounted ZVAL_ZVAL transfer so the owning decoding map retains a valid zval.",
    "SOAP response bounds use the native signed int string length limit.",
    "HTTP context access and TLS/Phar TSRMLS arguments retain native APIs.",
    "IPv6 comparison changes the FPM-local FastCGI implementation.",
    "Published regression tests use PHP 5.6-compatible syntax.",
    "The mysqlnd fake-server helper defaults to port 33305 for existing single-argument published tests.",
    "Socket formatting uses long ports and char-pointer diagnostics; Phar cycle detection uses native hash lookups and TSRMLS arguments.",
    "Published ctype casts retain native buffer members and update the matching generated PDO and URL scanner sources."
  ],
  "limits": [
    "Selected published changes; not complete coverage of all post-EOL vulnerabilities.",
    "Allocation failure exits the process; session upload progress is disabled in source.",
    "Modern deferred allocation-failure recovery and PHP 7 zend_string/early-RINIT guards are not present."
  ],
