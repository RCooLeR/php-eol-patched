+static zend_bool phar_tar_type_has_data(char typeflag)
+{
+	switch (typeflag) {
+		case TAR_LINK:
+		case TAR_SYMLINK:
+		case TAR_CHAR:
+		case TAR_BLOCK:
+		case TAR_DIR:
+		case TAR_FIFO:
+			return 0;
+		default:
+			return 1;
+	}
+}
+
+static zend_bool phar_tar_size(const char *buf, size_t len, uint32_t *result)
+{
+	uint64_t num = 0;
+	size_t i = 0;
+
+	while (i < len && buf[i] == ' ') {
+		++i;
+	}
+
+	/* GNU base-256 encoding is only used for sizes that do not fit the octal field */
+	if (i < len && (((unsigned char) buf[i]) & 0x80)) {
+		return 0;
+	}
+
+	while (i < len && buf[i] >= '0' && buf[i] <= '7') {
+		num = num * 8 + (buf[i] - '0');
+		++i;
+	}
+
+	while (i < len && (buf[i] == ' ' || buf[i] == '\0')) {
+		++i;
+	}
+
+	if (i != len || num > UINT32_MAX - 511) {
+		return 0;
+	}
+
+	*result = (uint32_t) num;
+	return 1;
+}
