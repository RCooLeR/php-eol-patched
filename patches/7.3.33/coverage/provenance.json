  "verification_limits": {
    "gd": "The published CVE-2026-9672 commit contains no regression fixture. Existing gif.phpt is an ordinary compatibility control, not an exploit reproduction.",
    "openssl": "Run the unchanged upstream gh22186.phpt only where its actual cipher probe succeeds; an unsupported-cipher skip is not a passing regression.",
    "phar": "The three circular-symlink tar fixtures and their PHPT are byte-identical to upstream. The additional ordinary-link control checks the published path-separator adaptation.",
    "pdo_sqlite": "The published bug81740.phpt allocates 2 GiB and runs separately with an 8 GiB container limit. Normal quoting and a native argument-width boundary check run in the default suite.",
    "sha3": "The PHP 7.2/7.3 wrapper truncates large lengths before the reported native overflow condition; its separate digest truncation remains. Native tests cover both sponge implementations; the 4 GiB vector is opt-in. Supported images are amd64."
  }
}
